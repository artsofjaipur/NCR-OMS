{
  "version": 2,
  "rewrites": [
    { "source": "/",
      "destination": "/index.html" },
    { "source": "/login",
      "destination": "/api" },
    { "source": "/create-account",
      "destination": "/api" },
    { "source": "/forgot-password",
      "destination": "/api" },
    { "source": "/reset-password",
      "destination": "/api" },
    { "source": "/health",
      "destination": "/api" },
    { "source": "/auth/:path*",
      "destination": "/api" },
    { "source": "/companies/:path*",
      "destination": "/api" },
    { "source": "/skus/:path*",
      "destination": "/api" },
    { "source": "/warehouses/:path*",
      "destination": "/api" },
    { "source": "/orders/:path*",
      "destination": "/api" },
    { "source": "/dispatch/:path*",
      "destination": "/api" },
    { "source": "/returns/:path*",
      "destination": "/api" },
    { "source": "/payouts/:path*",
      "destination": "/api" },
    { "source": "/pnl/:path*",
      "destination": "/api" },
    { "source": "/purchases/:path*",
      "destination": "/api" }
  ]
}
