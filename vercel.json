{
  "version": 2,
  "redirects": [
    { "source": "/",
      "destination": "/home",
      "permanent": false }
  ],
  "rewrites": [
    { "source": "/login",
      "destination": "/api" },
    { "source": "/create-account",
      "destination": "/api" },
    { "source": "/forgot-password",
      "destination": "/api" },
    { "source": "/reset-password",
      "destination": "/api" },
    { "source": "/home",
      "destination": "/api" },
    { "source": "/app",
      "destination": "/api" },
    { "source": "/scan",
      "destination": "/api" },
    { "source": "/dashboard/:path*",
      "destination": "/api" },
    { "source": "/health",
      "destination": "/api" },
    { "source": "/auth/:path*",
      "destination": "/api" },
    { "source": "/companies/:path*",
      "destination": "/api" },
    { "source": "/skus/:path*",
      "destination": "/api" },
    { "source": "/warehouses/:path*",
      "destination": "/api" },
    { "source": "/orders/:path*",
      "destination": "/api" },
    { "source": "/dispatch/:path*",
      "destination": "/api" },
    { "source": "/returns/:path*",
      "destination": "/api" },
    { "source": "/payouts/:path*",
      "destination": "/api" },
    { "source": "/pnl/:path*",
      "destination": "/api" },
    { "source": "/purchases/:path*",
      "destination": "/api" },
    { "source": "/suppliers/:path*",
      "destination": "/api" },
    { "source": "/finance",
      "destination": "/api" },
    { "source": "/finance/:path*",
      "destination": "/api" },
    { "source": "/users/:path*",
      "destination": "/api" },
    { "source": "/reports",
      "destination": "/api" },
    { "source": "/reports/:path*",
      "destination": "/api" },
    { "source": "/assistant/:path*",
      "destination": "/api" },
    { "source": "/entry/:path*",
      "destination": "/api" },
    { "source": "/dashboard",
      "destination": "/api" }
  ]
}
